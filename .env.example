# MongoDB Connection String
# Leave blank to auto-start an embedded MongoDB Replica Set (supports ACID transactions) for local development,
# or provide a MongoDB Atlas / local replica-set URI (e.g., mongodb://127.0.0.1:27017/smartpark?replicaSet=rs0)
MONGODB_URI=""

# JWT Signing Secret (change in production)
JWT_SECRET="replace-with-a-strong-random-secret-key"

# Server Port (must be 3000 in AI Studio preview)
PORT=3000

# Application URL
APP_URL="http://localhost:3000"
